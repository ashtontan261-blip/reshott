[sub_resource type="GDScript" id="GDScript_qbdty"]
resource_name = "checkpoint"
script/source = "extends Area3D

@export var checkpoint_id: int = 1

func _ready() -> void:
	body_entered.connect(_on_body_entered)

func _on_body_entered(body: Node3D) -> void:
	if body is CharacterBody3D:
		if checkpoint_id > body.current_checkpoint_id:
				body.current_checkpoint_id = checkpoint_id
				body.respawn_position = global_position + Vector3(0, 1, 0)
		
"


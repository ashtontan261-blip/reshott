[sub_resource type="GDScript" id="GDScript_4xowi"]
script/source = "extends CharacterBody3D

@onready var neck := $neck
@onready var camera := $neck/Camera3D
@onready var ray_cast_3d: RayCast3D = %RayCast3D
@onready var raycast_end: Node3D = %RayCastEnd
@onready var bullet_start_marker: Marker3D = %BulletStartMarker
@export var respawn_position: Vector3 = Vector3(0, 5, 0)
@export var normal_fov: float = 75.0
@export var ads_fov: float = 40.0
@export var ads_speed: float = 0.15
@onready var gun_node: Node3D = $neck/Camera3D/\"Automag 3\"
@export var gun_ads_position: Vector3 = Vector3(0, -0.186, -0.409)
@export var gun_ads_rotation: Vector3 = Vector3(0, 90, 0)
@onready var crosshair: Control = %Crosshair

var bullet_velocity: Vector3 = Vector3.ZERO
var current_checkpoint_id: int = 0
var is_ads_active: bool = false
var gun_default_position: Vector3
var gun_default_rotation: Vector3
const BULLET = preload(\"res://scenes/bullet.tscn\")
const SPEED = 8.0
const JUMP_VELOCITY = 7


func _ready():
	add_to_group(\"player\")
	respawn_position = global_position
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	
	if gun_node:
		gun_default_position = gun_node.transform.origin
		gun_default_rotation = gun_node.transform.basis.get_euler()
	
func _input(event):
	if event.is_action_pressed(\"ui_cancel\"): get_tree().quit()
	
	if Input.is_action_just_pressed(\"left_mouse_click\"):
		_shoot()
	
	
func _shoot():
	var bulletNode = BULLET.instantiate() as Area3D
	get_tree().current_scene.add_child(bulletNode)
	bulletNode.global_position = bullet_start_marker.global_position
	bulletNode.direction = _get_shoot_direction()
	bulletNode.look_at(bulletNode.global_position + bulletNode.direction, Vector3.UP)
	
func _get_shoot_direction():
	var targetPoint: Vector3
	
	if ray_cast_3d.is_colliding():
		targetPoint = ray_cast_3d.get_collision_point()
	else:
		targetPoint = raycast_end.global_position
	
	return bullet_start_marker.global_position.direction_to(targetPoint)


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	elif event.is_action_pressed(\"ui_cancel\"):
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		if event is InputEventMouseMotion:
			neck.rotate_y(-event.relative.x * 0.01)
			camera.rotate_x(-event.relative.y * 0.01)
			camera.rotation.x = clamp(camera.rotation.x, deg_to_rad(-90), deg_to_rad(90))
		

	if event.is_action_pressed(\"ads\") or Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT):
		if not is_ads_active:
			is_ads_active = true
			_zoom(true)
	elif is_ads_active:
		is_ads_active = false
		_zoom(false)

var ads_tween: Tween
func _zoom(is_ads: bool):
	if ads_tween and ads_tween.is_running():
		ads_tween.kill()
		
	ads_tween = create_tween().set_parallel(true).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	
	if is_ads:
		crosshair.visible = false
		ads_tween.tween_property(camera, \"fov\", ads_fov, ads_speed)
		if gun_node:
			ads_tween.tween_property(gun_node, \"transform:origin\", gun_ads_position, ads_speed)
			ads_tween.tween_property(gun_node, \"rotation_degrees\", gun_ads_rotation, ads_speed)
	else:
		crosshair.visible = true
		ads_tween.tween_property(camera, \"fov\", normal_fov, ads_speed)
		if gun_node:
			ads_tween.tween_property(gun_node, \"transform:origin\", gun_default_position, ads_speed)
			ads_tween.tween_property(gun_node, \"rotation\", gun_default_rotation, ads_speed)

func _physics_process(delta: float) -> void:
	ray_cast_3d.force_raycast_update()
	
	if ray_cast_3d.is_colliding():
		var collider = ray_cast_3d.get_collider()
		var hit_normal = ray_cast_3d.get_collision_normal()
		bullet_velocity = bullet_velocity.bounce(hit_normal)
		
	if not is_on_floor():
		velocity += get_gravity() * 1.4 * delta

	if global_position.y < -15.0:
		global_position = respawn_position
		velocity = Vector3.ZERO


	
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	
	
	var input_dir := Input.get_vector(\"left\", \"right\", \"forward\", \"back\")
	var direction = (neck.transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	if direction:
		velocity.x = direction.x * SPEED
		velocity.z = direction.z * SPEED
	else:
		
		velocity.x = move_toward(velocity.x, 0, SPEED)
		velocity.z = move_toward(velocity.z, 0, SPEED)

	move_and_slide()
"

